# Only application source and build tests belong in the build context.
**
!Dockerfile
!src/
!src/**
!tests/
!tests/**

# Re-exclude generated files and unused local scaffolding within those directories.
**/__pycache__/
**/*.py[cod]
**/*.mp4
**/*.part
**/*.ytdl
**/*.log
**/.env
**/.env.*
src/downloaded_tiktoks/
src/storage/
src/requests/
tests/.pytest_cache/
