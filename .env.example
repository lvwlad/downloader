# Host port and interface. Use 0.0.0.0 to allow connections from other devices.
PORT=8000
BIND_HOST=127.0.0.1

# Optional proxy, supplied at runtime only. Never commit credentials.
# Example: socks5://username:password@proxy.example.com:1080
TIKTOK_PROXY=

# Optional Netscape cookies file. Place it in ./cookies/tiktok.txt.
# Container path: /run/cookies/tiktok.txt
TIKTOK_COOKIES_FILE=
